---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <header>
      <p class="meta muted"><time class="num" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
      <h1>{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
    </header>
    <div class="body prose">
      <Content />
    </div>
    <footer class="prose">
      <p><a href="/writing/">More writing</a></p>
    </footer>
  </article>
</Base>

<style>
  .post { padding-top: clamp(24px, 5vw, 56px); padding-bottom: 72px; }
  header { max-width: 30em; margin-bottom: 40px; }
  header h1 { font-size: clamp(2rem, 4.4vw, 3rem); }
  .meta { font-family: var(--font-display); margin-bottom: 14px; }
  .standfirst { font-size: 1.3rem; line-height: 1.45; color: var(--muted); }
  .body { line-height: 1.7; }
  .body :global(h2) { font-size: var(--step-1); margin-top: 1.8em; }
  .body :global(li) { margin-bottom: 0.4em; }
  .body :global(strong) { font-weight: 650; }
  footer { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--rule); }
</style>
