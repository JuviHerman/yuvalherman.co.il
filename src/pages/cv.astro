---
import Base from '../layouts/Base.astro';
import { profile, jobs, skills, projects, education, languages } from '../data';
const cvProjects = projects.slice(0, 2);
---
<Base title="CV" description={`CV of ${profile.name}, ${profile.role}.`}>
  <article class="wrap cv">
    <header class="cv-head">
      <div>
        <h1>{profile.name}</h1>
        <p class="sub">{profile.role}, {profile.location}</p>
        <p class="contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.linkedin}>linkedin.com/in/hermanyuval</a>
          <a href="https://www.yuvalherman.co.il">yuvalherman.co.il</a>
        </p>
      </div>
      <a class="button download" href="/Yuval_Herman_CV.pdf" download>Download PDF</a>
    </header>

    <section>
      <h2>Profile</h2>
      <p>
        Data Scientist with 6 years of experience developing and deploying machine learning solutions,
        specializing in credit risk and fraud. Experienced in end-to-end modeling, statistical evaluation
        and applied AI, with a prior career in accounting and finance (CPA).
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      {jobs.map((j) => (
        <div class="job">
          <h3>
            <span>{j.title}, <span class="co">{j.company}{j.place && `, ${j.place}`}</span></span>
            <span class="num years">{j.start}–{j.end}</span>
          </h3>
          <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Technical skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Selected projects</h2>
      {cvProjects.map((p) => (
        <p><strong>{p.name}</strong>: {p.blurb} {p.href && <a href={p.href}>{p.linkLabel}</a>}</p>
      ))}
    </section>

    <section>
      <h2>Education &amp; certification</h2>
      {education.map((e) => (
        <p class="edu">
          <strong>{e.name}</strong>, {e.org}{e.year && `, ${e.year}`}
          {e.note && <><br /><span class="muted">{e.note}</span></>}
        </p>
      ))}
    </section>

    <section class="pair">
      <div><h2>Languages</h2><p>{languages.join(', ')}</p></div>
      <div><h2>Interests</h2><p>Chess, competitive player in a local community league</p></div>
    </section>
  </article>
</Base>

<style>
  .cv { max-width: 880px; padding-top: clamp(24px, 5vw, 56px); padding-bottom: 72px; }
  .cv-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
  .cv-head h1 { margin-bottom: 0.1em; }
  .sub { font-family: var(--font-display); font-size: var(--step-1); color: var(--green); margin: 0 0 8px; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; font-size: 1rem; }
  section { padding: 22px 0 6px; border-bottom: 1px solid var(--rule); }
  section:last-child { border-bottom: 0; }
  h2 { font-size: 1.05rem; color: var(--green); margin-bottom: 0.7em; }
  .job { margin-bottom: 18px; }
  .job h3 { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; font-size: 1.1rem; margin-bottom: 0.4em; }
  .co { font-weight: 450; }
  .years { color: var(--muted); font-weight: 500; }
  .job ul { margin: 0; padding-left: 1.2em; }
  .job li { margin-bottom: 0.35em; }
  .skills { margin: 0 0 16px; }
  .skills div { display: grid; grid-template-columns: 15em minmax(0, 1fr); gap: 4px 16px; margin-bottom: 6px; }
  .skills dt { font-family: var(--font-display); font-weight: 600; }
  .skills dd { margin: 0; }
  @media (max-width: 640px) { .skills div { grid-template-columns: minmax(0, 1fr); gap: 0; margin-bottom: 12px; } }
  .edu { margin-bottom: 0.7em; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 640px) { .pair { grid-template-columns: 1fr; } }

  @media print {
    @page { size: A4; margin: 10mm 13mm; }
    :global(:root), :global(:root:not([data-theme='light'])), :global(:root[data-theme='dark']) { --paper: #fff; --surface: #fff; --ink: #13203a; --muted: #4c5667; --rule: #cfd5de; --green: #17704f; }
    :global(body) { font-size: 9.2pt; line-height: 1.34; background: #fff; }
    .cv { padding: 0; max-width: none; }
    .download { display: none; }
    .cv-head { padding-bottom: 8px; }
    .cv-head h1 { font-size: 22pt; }
    .sub { font-size: 12pt; margin-bottom: 2px; }
    .contact { font-size: 9pt; }
    section { padding: 6px 0 1px; break-inside: avoid; }
    h2 { font-size: 10.5pt; margin-bottom: 4px; }
    .job { margin-bottom: 6px; }
    .job h3 { font-size: 10.2pt; margin-bottom: 2px; }
    .job li { margin-bottom: 1px; }
    .skills div { grid-template-columns: 13em 1fr; margin-bottom: 2px; }
    p { margin-bottom: 4px; }
    a { text-decoration: none; }
  }
</style>
