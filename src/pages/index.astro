---
import Base from '../layouts/Base.astro';
import ThresholdCurve from '../components/ThresholdCurve.astro';
import PostList from '../components/PostList.astro';
import { profile, jobs, projects } from '../data';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 3);

const focus = [
  {
    name: 'Credit risk',
    text: 'Scoring models for three international markets, owned from feature development through deployment and monitoring. The current generation beats its baseline by 0.07 ROC-AUC.',
  },
  {
    name: 'Fraud',
    text: 'Detection rules for a lending population that cut fraud by 2.5%, and behavioral and graph-based features that feed the risk models.',
  },
  {
    name: 'Causal decisioning',
    text: 'Uplift models that tell Collections which customers to contact, based on how each one is likely to respond, not just whether they will pay.',
  },
  {
    name: 'Applied AI',
    text: 'Agentic workflows for model training, feature-accuracy validation and document parsing, with human review at the checkpoints that matter.',
  },
];
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="role">{profile.role} in {profile.location}</p>
      <h1>Credit-risk models, built by someone who used to audit the books.</h1>
      <p class="lede">
        I've spent six years building and deploying machine learning for lending: who gets approved,
        what looks like fraud, and who Collections should call. Before that I was a CPA, so I think
        about the losses avoided and the revenue given up at every cutoff.
      </p>
      <div class="actions">
        <a class="button" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button ghost" href="/cv/">Read my CV</a>
      </div>
    </div>
    <div class="hero-figure">
      <p class="try">Try it: move the cutoff and see who gets approved.</p>
      <ThresholdCurve />
    </div>
  </section>

  <section class="section">
    <div class="wrap section-grid">
      <h2>What I work on</h2>
      <dl class="focus">
        {focus.map((f) => (
          <div><dt>{f.name}</dt><dd>{f.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap section-grid">
      <h2>Experience</h2>
      <div>
        <ol class="timeline">
          {jobs.map((j) => (
            <li>
              <span class="years num muted">{j.start}–{j.end}</span>
              <span><strong>{j.title}</strong>, {j.company}</span>
            </li>
          ))}
          <li>
            <span class="years num muted">2020</span>
            <span><strong>Data Science Fellowship</strong>, Israel Tech Challenge</span>
          </li>
        </ol>
        <p><a href="/cv/">See the full CV</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap section-grid">
      <h2>Projects</h2>
      <ul class="projects">
        {projects.map((p) => (
          <li>
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            {p.href && <a href={p.href}>{p.linkLabel}</a>}
            <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap section-grid">
        <h2>Writing</h2>
        <div>
          <PostList posts={posts} />
          <p class="more"><a href="/writing/">All writing</a></p>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px); align-items: center;
    padding-top: clamp(24px, 6vw, 72px); padding-bottom: clamp(56px, 8vw, 96px);
  }
  .role { font-family: var(--font-display); font-weight: 500; color: var(--green); margin-bottom: 18px; }
  .lede { font-size: 1.2rem; max-width: 54ch; color: var(--ink); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .try { font-family: var(--font-display); font-size: 0.95rem; color: var(--muted); margin: 0 0 10px 4px; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }

  .focus { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 40px; margin: 0; }
  .focus dt { font-family: var(--font-display); font-weight: 650; font-size: 1.1rem; margin-bottom: 4px; }
  .focus dd { margin: 0; color: var(--muted); }
  @media (max-width: 640px) { .focus { grid-template-columns: minmax(0, 1fr); } }

  .timeline { list-style: none; margin: 0 0 20px; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .timeline li:first-child { padding-top: 0; }
  .years { font-family: var(--font-display); font-size: 0.95rem; padding-top: 0.15em; }
  .timeline strong { font-family: var(--font-display); font-weight: 600; }

  .projects { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .projects > li p { color: var(--muted); margin-bottom: 8px; }
  .projects h3 { margin-bottom: 0.35em; }
  @media (max-width: 640px) { .projects { grid-template-columns: minmax(0, 1fr); } }

  .more { margin-top: 20px; }
</style>
