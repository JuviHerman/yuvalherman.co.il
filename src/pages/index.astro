---
import Base from '../layouts/Base.astro';
import SkillMap from '../components/SkillMap.astro';
import CutoffLab from '../components/CutoffLab.astro';
import PostList from '../components/PostList.astro';
import { profile, jobs, skillAreas, languages } from '../data';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="hero wrap" id="home">
    <img class="portrait" src="/portrait.svg" alt="Illustrated portrait of Yuval Herman" width="400" height="400" />
    <div class="intro">
      <h1>Yuval Herman</h1>
      <p class="caps kicker">{profile.role}, {profile.location}</p>
      <p class="lede">
        I build machine learning for lending: who gets approved, what looks like fraud, and who is
        worth a call. Before data science I was a CPA, and I still read every model like a ledger.
      </p>
      <ul class="areas" aria-label="Skill areas">
        {skillAreas.map((a) => <li><a href={`#skill-${a.id}`}>{a.name}</a></li>)}
      </ul>
      <div class="actions">
        <a class="button" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button ghost" href="/cv/">Read my CV</a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <h2 class="section-title">Skills and projects</h2>
      <SkillMap />
    </div>
  </section>

  <section class="section" id="lab">
    <div class="wrap">
      <div class="lab-head">
        <h2>Where would you set the cutoff?</h2>
        <p class="muted">Price your mistakes, then find the threshold that costs least.</p>
      </div>
      <CutoffLab />
    </div>
  </section>

  <section class="section" id="experience">
    <div class="wrap section-grid">
      <h2>Experience</h2>
      <div>
        <ol class="timeline">
          {jobs.map((j) => (
            <li>
              <span class="years num muted">{j.start}–{j.end}</span>
              <span><strong>{j.title}</strong>, {j.company}</span>
            </li>
          ))}
        </ol>
        <p><a href="/cv/">See the full CV</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap section-grid">
      <h2>About</h2>
      <div class="prose about">
        <p>
          I started as a financial auditor at UHY Israel and spent time as the controller of a listed
          financial-services firm. That taught me what a number goes through before it reaches a report,
          and what it costs when it's wrong.
        </p>
        <p>
          At Dov &amp; Co, a CPA firm, I wrote financial software and blockchain applications and advised on
          digital-asset regulation and tax. Automating the work I knew from audits led me to data science:
          the Israel Tech Challenge fellowship in 2020, then Fido Credit Solutions, where I've built risk,
          fraud and collections models and the agentic workflows around them.
        </p>
        <p>
          Away from work I play competitive chess in a local league, and I treat that like a modeling
          problem too: <a href="/#chess">a bandit</a> picks my next game.
        </p>
        <p class="muted">{languages.join(' and ')}.</p>
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="wrap section-grid">
      <h2>Writing</h2>
      <div>
        {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">First essays are on the way.</p>}
        <p class="more"><a href="/writing/">All writing</a></p>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap contact">
      <h2>Get in touch</h2>
      <p class="lede">Open to conversations about credit risk, causal ML and applied AI. Email is the fastest way to reach me.</p>
      <div class="actions">
        <a class="button" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="button ghost" href={profile.linkedin}>LinkedIn</a>
        <a class="button ghost" href={profile.github}>GitHub</a>
        <a class="button ghost" href="/Yuval_Herman_CV.pdf" download>Download CV</a>
      </div>
      <p class="muted where">{profile.location}</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px); align-items: center;
    padding-top: clamp(32px, 6vw, 80px); padding-bottom: clamp(56px, 8vw, 104px);
  }
  .portrait { display: block; width: 100%; max-width: 400px; height: auto; justify-self: start; }
  .intro { text-align: right; }
  h1 { font-size: clamp(3rem, 7vw, 5.4rem); line-height: 1; margin-bottom: 0.35em; }
  .kicker { color: var(--accent); margin-bottom: 22px; }
  .lede { font-size: 1.2rem; line-height: 1.6; max-width: 46ch; margin-left: auto; }
  .areas { list-style: none; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 18px; margin: 18px 0 0; padding: 0; }
  .areas a { font-family: var(--font-heading); font-size: 1.2rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12px; margin-top: 28px; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .portrait { max-width: 260px; justify-self: center; }
    .intro { text-align: center; }
    .lede { margin: 0 auto; }
    .areas, .actions { justify-content: center; }
  }

  .section-title { font-size: var(--step-2); margin-bottom: 28px; }
  .about p { margin-bottom: 1.1em; }
  .contact { text-align: center; }
  .contact h2 { font-size: var(--step-3); }
  .contact .lede { margin: 0 auto; }
  .contact .actions { justify-content: center; }
  .where { margin-top: 24px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .lab-head { margin-bottom: 28px; }
  .lab-head h2 { font-size: var(--step-2); margin-bottom: 0.2em; }
  .lab-head p { font-size: 1.15rem; margin: 0; }

  .timeline { list-style: none; margin: 0 0 20px; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .timeline li:first-child { padding-top: 0; }
  .years { font-family: var(--font-display); font-size: 0.95rem; padding-top: 0.15em; }
  .timeline strong { font-weight: 550; }

  .more { margin-top: 20px; }
</style>
