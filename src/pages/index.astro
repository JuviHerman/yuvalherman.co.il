---
import Base from '../layouts/Base.astro';
import SkillMap from '../components/SkillMap.astro';
import CutoffLab from '../components/CutoffLab.astro';
import PostList from '../components/PostList.astro';
import { profile, jobs, skillAreas } from '../data';
import { getPosts } from '../lib';

const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="hero wrap">
    <div class="persona">
      <img class="portrait" src="/portrait.svg" alt="Illustrated portrait of Yuval Herman" width="168" height="168" />
      <h1>Yuval<br />Herman</h1>
      <p class="role">{profile.role}, {profile.location}</p>
      <p class="lede">Machine learning for lending. Formerly a CPA.</p>
      <div class="actions">
        <a class="button" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button ghost" href="/cv/">Read my CV</a>
      </div>
    </div>
    <nav class="index" aria-label="Skill areas">
      <ul>
        {skillAreas.map((a) => (
          <li>
            <a href={`#skill-${a.id}`}>
              <span class="area">{a.name}</span>
              <span class="subs">{a.subs.map((s) => s.name).join(', ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="section" id="skills">
    <div class="wrap">
      <h2 class="visually-hidden">Skills and selected work</h2>
      <SkillMap />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="lab-head">
        <h2>Where would you set the cutoff?</h2>
        <p class="muted">Price your mistakes, then find the threshold that costs least.</p>
      </div>
      <CutoffLab />
    </div>
  </section>

  <section class="section">
    <div class="wrap section-grid">
      <h2>Experience</h2>
      <div>
        <ol class="timeline">
          {jobs.map((j) => (
            <li>
              <span class="years num muted">{j.start}–{j.end}</span>
              <span><strong>{j.title}</strong>, {j.company}</span>
            </li>
          ))}
        </ol>
        <p><a href="/cv/">See the full CV</a></p>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap section-grid">
        <h2>Writing</h2>
        <div>
          <PostList posts={posts} />
          <p class="more"><a href="/writing/">All writing</a></p>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px); align-items: end;
    padding-top: clamp(32px, 7vw, 96px); padding-bottom: clamp(56px, 8vw, 104px);
  }
  @media (max-width: 860px) { .hero { grid-template-columns: minmax(0, 1fr); align-items: start; } }

  .portrait { display: block; width: clamp(120px, 16vw, 168px); height: auto; margin: 0 0 20px -6px; }
  h1 { font-size: clamp(3.6rem, 11vw, 8.5rem); line-height: 0.9; letter-spacing: -0.045em; font-weight: 800; margin-bottom: 0.3em; }
  .role { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); color: var(--green); margin-bottom: 6px; }
  .lede { font-size: 1.25rem; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }

  .index ul { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .index li { border-bottom: 1px solid var(--rule); }
  .index a { display: grid; gap: 2px; padding: 16px 0; text-decoration: none; }
  .area { font: 700 clamp(1.6rem, 3.2vw, 2.3rem)/1.1 var(--font-display); letter-spacing: -0.025em; }
  .subs { font-family: var(--font-display); color: var(--muted); font-size: 1rem; }
  .index a:hover .area { color: var(--green); }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .lab-head { margin-bottom: 28px; }
  .lab-head h2 { font-size: var(--step-3); margin-bottom: 0.2em; }
  .lab-head p { font-size: 1.15rem; margin: 0; }

  .timeline { list-style: none; margin: 0 0 20px; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .timeline li:first-child { padding-top: 0; }
  .years { font-family: var(--font-display); font-size: 0.95rem; padding-top: 0.15em; }
  .timeline strong { font-family: var(--font-display); font-weight: 600; }

  .more { margin-top: 20px; }
</style>
