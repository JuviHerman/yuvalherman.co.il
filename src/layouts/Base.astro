---
import '../styles/global.css';
import { profile } from '../data';
import ChessRail from '../components/ChessRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.summary } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name}, ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/chess/', label: 'Chess' },
  { href: '/cv/', label: 'CV' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f2f2f1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Commissioner:wght@300..700&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      email: `mailto:${profile.email}`,
      url: Astro.site?.href,
      sameAs: [profile.linkedin, profile.github],
      address: { '@type': 'PostalAddress', addressLocality: 'Tel Aviv', addressCountry: 'IL' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>Yuval Herman</a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>
          Write to me at <a href={`mailto:${profile.email}`}>{profile.email}</a>, or find me on
          <a href={profile.linkedin}>LinkedIn</a> and <a href={profile.github}>GitHub</a>.
        </p>
        <p class="muted">Tel Aviv. Built with Astro, hosted on GitHub Pages.</p>
      </div>
    </footer>
    <ChessRail />
  </body>
</html>

<style>
  .site-header {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding-top: 22px; padding-bottom: 22px;
  }
  .wordmark {
    font-family: var(--font-heading); font-weight: 450; font-size: 1.3rem; letter-spacing: -0.01em;
    color: var(--accent); text-decoration: none;
  }
  nav ul { display: flex; gap: clamp(14px, 3vw, 28px); list-style: none; margin: 0; padding: 0; }
  nav a { font-family: var(--font-ui); font-size: 0.8rem; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; color: var(--accent); }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.45em; }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 24px; padding: 40px 0 56px; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; }
  .footer-inner p { margin: 0; max-width: 60ch; font-size: 0.9rem; }
  @media print { .site-header, .site-footer, .skip { display: none; } }
</style>
