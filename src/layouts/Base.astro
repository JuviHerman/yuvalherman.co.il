---
import '../styles/global.css';
import { profile } from '../data';
import ChessRail from '../components/ChessRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.summary } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name}, ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Every link points at a section of the home page; from other pages it navigates back there.
const nav = [
  { id: 'home', label: 'Home' },
  { id: 'projects', label: 'Projects' },
  { id: 'experience', label: 'Experience' },
  { id: 'about', label: 'About' },
  { id: 'chess', label: 'Chess' },
  { id: 'writing', label: 'Writing' },
  { id: 'contact', label: 'Contact' },
];
const github = 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';
const linkedin = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f2f2f1" />
    <script is:inline>
      // Apply the saved or system theme before first paint.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Commissioner:wght@300..700&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      email: `mailto:${profile.email}`,
      url: Astro.site?.href,
      sameAs: [profile.linkedin, profile.github],
      address: { '@type': 'PostalAddress', addressLocality: 'Tel Aviv', addressCountry: 'IL' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/#home">Yuval Herman</a>
        <nav class="links" aria-label="Sections">
          <ul>{nav.map((n) => <li><a href={`/#${n.id}`} data-section={n.id}>{n.label}</a></li>)}</ul>
        </nav>
        <div class="tools">
          <a class="icon" href={profile.github} aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={github} /></svg></a>
          <a class="icon" href={profile.linkedin} aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkedin} /></svg></a>
          <a class="resume" href="/cv/">Resume</a>
          <button class="theme" type="button" aria-label="Toggle dark mode">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
          </button>
          <details class="menu">
            <summary aria-label="Open menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg></summary>
            <ul>{nav.map((n) => <li><a href={`/#${n.id}`}>{n.label}</a></li>)}</ul>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="muted">© {new Date().getFullYear()} {profile.name}, Tel Aviv.</p>
        <p class="muted"><a href="/rss.xml">RSS</a>. Built with Astro, hosted on GitHub Pages.</p>
      </div>
    </footer>
    <ChessRail />
    <script>
      const root = document.documentElement;
      document.querySelector('.theme')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Close the mobile menu after choosing a section.
      const menu = document.querySelector<HTMLDetailsElement>('.menu');
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));

      // Highlight the section currently in view (home page only).
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.links a[data-section]')];
      const sections = links.map((a) => document.getElementById(a.dataset.section!)).filter(Boolean) as HTMLElement[];
      if (sections.length) {
        const mark = (id: string) => links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.section === id));
        // A clicked link stays highlighted until the reader scrolls on their own.
        let pinned: string | null = null;
        const spy = () => {
          if (pinned) return;
          const line = innerHeight * 0.35;
          const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
          let current = sections[0].id;
          for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
          if (atBottom) current = sections.at(-1)!.id;
          mark(current);
        };
        links.forEach((a) => a.addEventListener('click', () => { pinned = a.dataset.section!; mark(pinned); }));
        for (const ev of ['wheel', 'touchstart', 'keydown']) addEventListener(ev, () => { pinned = null; }, { passive: true });
        addEventListener('scroll', spy, { passive: true });
        spy();
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 64px; }
  .wordmark {
    font-family: var(--font-heading); font-weight: 500; font-size: 1.3rem; letter-spacing: -0.01em;
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .links ul { display: flex; gap: clamp(16px, 2.6vw, 36px); list-style: none; margin: 0; padding: 0; }
  .links a { font-size: 0.95rem; font-weight: 400; color: var(--ink); text-decoration: none; padding: 6px 0; }
  .links a:hover, .links a[aria-current] { color: var(--accent); text-decoration: underline; text-underline-offset: 0.5em; text-decoration-thickness: 1.5px; }

  .tools { display: flex; align-items: center; gap: 14px; }
  .icon { display: grid; place-items: center; color: var(--ink); }
  .icon svg { width: 20px; height: 20px; fill: currentColor; }
  .icon:hover { color: var(--accent); }
  .resume {
    font-size: 0.9rem; color: var(--accent); text-decoration: none; white-space: nowrap;
    border: 1px solid var(--accent); border-radius: 6px; padding: 6px 14px;
  }
  .resume:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .theme { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); }
  .theme svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .theme .sun { stroke: #e8961e; fill: none; }
  .theme .sun circle { fill: #e8961e; }
  .theme .sun, :global([data-theme='light']) .theme .sun { display: none; }
  :global([data-theme='dark']) .theme .sun { display: block; }
  :global([data-theme='dark']) .theme .moon { display: none; }

  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 34px; height: 34px; color: var(--ink); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; fill: none; }
  .menu ul {
    position: absolute; right: 0; top: 44px; min-width: 180px; margin: 0; padding: 8px; list-style: none;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }
  .menu a { display: block; padding: 9px 12px; color: var(--ink); text-decoration: none; border-radius: 6px; }
  .menu a:hover { background: var(--paper); color: var(--accent); }

  @media (max-width: 980px) {
    .links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 420px) {
    .icon { display: none; }
  }

  .site-footer { border-top: 1px solid var(--rule); margin-top: 24px; padding: 40px 0 56px; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; }
  .footer-inner p { margin: 0; max-width: 60ch; font-size: 0.9rem; }
  @media print { .site-header, .site-footer, .skip { display: none; } }
</style>
