---
// Threshold game over a synthetic loan book: price each cell of the confusion matrix,
// then slide the cutoff to the most profitable point. The peak is never marked, and the
// slider starts deliberately away from it. Rendered at build time; the script recomputes.
import MatrixCell from './MatrixCell.astro';
import { applicants, confusion, netCurve, cutoffs, cutIndex, money, DEFAULT_VALUES, MIN_CUT, MAX_CUT } from '../cutoff';

const curve = netCurve(DEFAULT_VALUES);
const best = cutoffs[curve.values.indexOf(curve.max)];
const initialCut = Math.round(Math.min(MAX_CUT, Math.max(MIN_CUT, best > 0.5 ? best - 0.35 : best + 0.35)) * 100) / 100;
const m0 = confusion(initialCut);
const n0 = curve.values[cutIndex(initialCut)];

const W = 400, H = 150, T = 10; // chart width, plot height, top offset
const x = (c: number) => ((c - MIN_CUT) / (MAX_CUT - MIN_CUT)) * W;
const y = (v: number) => T + H * (1 - (v - curve.min) / Math.max(curve.max - curve.min, 1));
const path = curve.values.map((v, i) => `${i ? 'L' : 'M'}${x(cutoffs[i]).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');

const cells = [
  { k: 'tp', abbr: 'TP', name: 'Defaulter declined', verb: 'Gain', note: 'loss avoided' },
  { k: 'fp', abbr: 'FP', name: 'Good customer declined', verb: 'Cost', note: 'profit forgone' },
  { k: 'fn', abbr: 'FN', name: 'Defaulter approved', verb: 'Cost', note: 'loss taken' },
  { k: 'tn', abbr: 'TN', name: 'Good customer approved', verb: 'Gain', note: 'profit earned' },
] as const;
---
<div class="lab" data-w={W} data-h={H} data-t={T}>
  <div class="matrix" role="group" aria-label="Confusion matrix with a value per case">
    <span></span>
    <span class="col caps">Will default</span>
    <span class="col caps">Will repay</span>
    <span class="row caps">Declined</span>
    {cells.slice(0, 2).map((c) => <MatrixCell {...c} count={m0[c.k]} value={DEFAULT_VALUES[c.k]} />)}
    <span class="row caps">Approved</span>
    {cells.slice(2).map((c) => <MatrixCell {...c} count={m0[c.k]} value={DEFAULT_VALUES[c.k]} />)}
  </div>

  <div class="game">
    <div class="control">
      <label for="cutoff">Decline above</label>
      <input id="cutoff" type="range" min={MIN_CUT} max={MAX_CUT} step="0.01" value={initialCut} />
      <output for="cutoff" class="num" id="cutoff-value">{initialCut.toFixed(2)}</output>
    </div>

    <svg viewBox={`0 0 ${W} ${T + H + 20}`} role="img" aria-label="Net profit at every threshold; the dot is your threshold.">
      <line class="zero" x1="0" x2={W} y1={y(0)} y2={y(0)} visibility={curve.min < 0 && curve.max > 0 ? 'visible' : 'hidden'} />
      <path class="net-path" d={path} />
      <line class="cur-line" x1={x(initialCut)} x2={x(initialCut)} y1={T} y2={T + H} />
      <circle class="cur-dot" cx={x(initialCut)} cy={y(n0)} r="6" />
      <text x="0" y={T + H + 16} class="axis-text">Decline more</text>
      <text x={W / 2} y={T + H + 16} class="axis-text" text-anchor="middle">Net profit by threshold</text>
      <text x={W} y={T + H + 16} class="axis-text" text-anchor="end">Approve more</text>
    </svg>

    <div class="score" aria-live="polite">
      <p><span class="caps muted">Net profit</span><strong class="num" data-k="net">{money(n0)}</strong></p>
      <p class="hint muted"><span class="climb">Find the threshold that earns the most.</span><span class="peak">You found the peak. Change a price and it moves.</span></p>
    </div>
    <p class="note muted">Synthetic book of {applicants.length} applicants; values are per case.</p>
  </div>
</div>

<script>
  import { confusion, netCurve, cutoffs, cutIndex, money, signed, MIN_CUT, MAX_CUT, type Values } from '../cutoff';

  const lab = document.querySelector<HTMLElement>('.lab');
  if (lab) {
    const W = Number(lab.dataset.w), H = Number(lab.dataset.h), T = Number(lab.dataset.t);
    const $ = <E extends Element>(sel: string) => lab.querySelector<E>(sel)!;
    const cut = $<HTMLInputElement>('#cutoff');
    const keys = ['tp', 'fp', 'fn', 'tn'] as const;
    const inputs = Object.fromEntries(keys.map((k) => [k, $<HTMLInputElement>(`input[data-cell="${k}"]`)]));
    const sign = { tp: 1, fp: -1, fn: -1, tn: 1 };
    const values = (): Values => Object.fromEntries(keys.map((k) => [k, sign[k] * Math.max(0, Number(inputs[k].value) || 0)])) as Values;
    const x = (c: number) => ((c - MIN_CUT) / (MAX_CUT - MIN_CUT)) * W;

    let curve = netCurve(values());
    let y = (v: number) => v;

    const drawCurve = () => {
      curve = netCurve(values());
      y = (v) => T + H * (1 - (v - curve.min) / Math.max(curve.max - curve.min, 1));
      $('.net-path').setAttribute('d', curve.values.map((v, i) => `${i ? 'L' : 'M'}${x(cutoffs[i]).toFixed(1)} ${y(v).toFixed(1)}`).join(' '));
      const zero = $('.zero');
      zero.setAttribute('y1', y(0).toFixed(1));
      zero.setAttribute('y2', y(0).toFixed(1));
      zero.setAttribute('visibility', curve.min < 0 && curve.max > 0 ? 'visible' : 'hidden');
    };

    const drawCut = () => {
      const c = Number(cut.value);
      const m = confusion(c);
      const v = values();
      const n = curve.values[cutIndex(c)];
      $<HTMLOutputElement>('#cutoff-value').value = c.toFixed(2);
      $('.cur-line').setAttribute('x1', x(c).toFixed(1));
      $('.cur-line').setAttribute('x2', x(c).toFixed(1));
      $('.cur-dot').setAttribute('cx', x(c).toFixed(1));
      $('.cur-dot').setAttribute('cy', y(n).toFixed(1));
      for (const k of keys) {
        $(`[data-count="${k}"]`).textContent = String(m[k]);
        $(`[data-sub="${k}"]`).textContent = signed(m[k] * v[k]);
      }
      $('[data-k="net"]').textContent = money(n);
      lab.classList.toggle('at-peak', n === curve.max);
    };

    cut.addEventListener('input', drawCut);
    for (const k of keys) inputs[k].addEventListener('input', () => { drawCurve(); drawCut(); });
    drawCurve();
    drawCut();
  }
</script>

<style>
  .lab {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: start;
    padding: clamp(18px, 3vw, 32px); background: var(--surface); border: 1px solid var(--rule); border-radius: 18px;
  }
  @media (max-width: 860px) { .lab { grid-template-columns: minmax(0, 1fr); } }

  .matrix { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
  .col { text-align: center; color: var(--muted); font-size: 0.72rem; }
  .row { writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; color: var(--muted); font-size: 0.72rem; }

  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .control { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; margin-bottom: 14px; font-size: 0.95rem; }
  .control output { min-width: 3ch; font-weight: 650; }
  input[type='range'] { width: 100%; accent-color: var(--accent); min-height: 28px; }

  .zero { stroke: var(--rule); stroke-dasharray: 3 4; }
  .net-path { fill: none; stroke: var(--ink); stroke-width: 2.2; stroke-linejoin: round; }
  .cur-line { stroke: var(--accent); stroke-width: 1.2; opacity: 0.5; }
  .cur-dot { fill: var(--accent); stroke: var(--surface); stroke-width: 2.5; transition: fill 0.2s; }
  .at-peak .cur-dot { fill: var(--green); }
  .axis-text { font-family: var(--font-ui); font-size: 11px; fill: var(--muted); }

  .score { margin-top: 18px; }
  .score p { margin: 0; }
  .score strong { display: block; font: 600 2rem/1.2 var(--font-ui); font-variant-numeric: tabular-nums; }
  .at-peak .score strong { color: var(--green); }
  .hint { margin-top: 4px !important; }
  .hint .peak, .at-peak .hint .climb { display: none; }
  .at-peak .hint .peak { display: inline; color: var(--green); }
  .note { font-size: var(--step--1); margin: 14px 0 0; }
</style>
