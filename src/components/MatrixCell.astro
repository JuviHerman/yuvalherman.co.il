---
// One cell of the threshold game's confusion matrix: count, editable value per case, subtotal.
import { signed } from '../cutoff';

interface Props { k: string; abbr: string; name: string; verb: string; note: string; count: number; value: number }
const { k, abbr, name, verb, note, count, value } = Astro.props;
const gain = value >= 0;
---
<div class:list={['cell', gain ? 'gain' : 'cost']}>
  <p class="head"><span class="abbr">{abbr}</span> {name}</p>
  <p class="count num" data-count={k}>{count}</p>
  <label>
    <span class="verb">{verb} per case <span class="muted">({note})</span></span>
    <span class="money-input"><span class="prefix" aria-hidden="true">{gain ? '+$' : '−$'}</span><input data-cell={k} type="number" inputmode="numeric" min="0" step="50" value={Math.abs(value)} aria-label={`${abbr}: ${verb.toLowerCase()} per case`} /></span>
  </label>
  <p class="sub num" data-sub={k}>{signed(count * value)}</p>
</div>

<style>
  .cell { border-radius: 12px; padding: 12px; display: grid; gap: 6px; border: 1px solid var(--rule); }
  .gain { background: color-mix(in srgb, var(--green) 9%, var(--surface)); }
  .cost { background: color-mix(in srgb, var(--red) 8%, var(--surface)); }
  p { margin: 0; }
  .head { font-size: 0.82rem; line-height: 1.3; color: var(--muted); }
  .abbr { font-weight: 650; color: var(--ink); }
  .count { font: 600 1.7rem/1 var(--font-ui); }
  label { display: grid; gap: 4px; font-size: 0.75rem; color: var(--muted); }
  .money-input { display: flex; align-items: center; gap: 2px; border: 1.5px solid var(--rule); border-radius: 8px; padding: 0 8px; background: var(--surface); color: var(--ink); font-size: 0.9rem; }
  .prefix { white-space: nowrap; flex: none; }
  .money-input:focus-within { border-color: var(--focus); }
  input { width: 100%; min-width: 0; border: 0; background: transparent; color: inherit; font: 600 0.95rem var(--font-ui); padding: 6px 0; font-variant-numeric: tabular-nums; }
  input:focus { outline: none; }
  .sub { font-size: 0.85rem; font-weight: 550; }
  .gain .sub { color: var(--green); }
  .cost .sub { color: var(--red); }
</style>
