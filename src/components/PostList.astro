---
import { formatDate } from '../lib';

interface Props {
  posts: { id: string; data: { title: string; description: string; date: Date; draft: boolean } }[];
}
const { posts } = Astro.props;
---
<ol class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/writing/${post.id}/`}>
        <span class="t">{post.data.title}{post.data.draft && <em class="draft"> (draft)</em>}</span>
        <time class="num muted" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </a>
      <p class="muted">{post.data.description}</p>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  li { padding: 18px 0; border-bottom: 1px solid var(--rule); }
  li:first-child { padding-top: 0; }
  a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 20px; text-decoration: none; }
  .t { font-family: var(--font-heading); font-weight: 400; font-size: var(--step-1); line-height: 1.25; color: var(--accent); }
  a:hover .t { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  time { font-size: var(--step--1); white-space: nowrap; }
  p { margin: 6px 0 0; max-width: var(--measure); }
  .draft { color: var(--red); font-style: normal; font-size: 0.8em; }
</style>
