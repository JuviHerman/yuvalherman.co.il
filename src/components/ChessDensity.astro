---
// Beta posteriors for both arms with their 90th-percentile (UCB) lines and means.
import { current, densityPoints, ARMS, pct, type ArmId } from '../chess';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const W = compact ? 280 : 640;
const H = compact ? 110 : 250;
const top = compact ? 16 : 26;
const bottom = compact ? 16 : 30;
const plotH = H - top - bottom;
const ids: ArmId[] = ['night', 'day'];
const curves = ids.map((id) => ({ id, p: current[id], pts: densityPoints(current[id].a, current[id].b) }));
const yMax = Math.max(...curves.flatMap((c) => c.pts.map(([, y]) => y))) * 1.08;
const X = (x: number) => x * W;
const Y = (y: number) => top + plotH * (1 - y / yMax);
const line = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${X(x).toFixed(1)} ${Y(y).toFixed(1)}`).join(' ');
const area = (pts: [number, number][]) => `${line(pts)} L${X(1)} ${Y(0)} L${X(0)} ${Y(0)} Z`;
const label = `Win-rate distributions. ${ids.map((id) => `${ARMS[id].label}: mean ${pct(current[id].mean)}, 90th percentile ${pct(current[id].ucb)}`).join('. ')}.`;
---
<svg class:list={['density', { compact }]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {!compact && [0.25, 0.5, 0.75].map((g) => <line class="grid" x1={X(g)} x2={X(g)} y1={top} y2={Y(0)} />)}
  {curves.map((c) => (
    <g class={`arm ${c.id}`}>
      <path class="fill" d={area(c.pts)} />
      <path class="stroke" d={line(c.pts)} />
      <line class="ucb" x1={X(c.p.ucb)} x2={X(c.p.ucb)} y1={top - (compact ? 6 : 10)} y2={Y(0)} />
      <circle class="mean" cx={X(c.p.mean)} cy={Y(0)} r={compact ? 3 : 4.5} />
    </g>
  ))}
  <line class="axis" x1="0" x2={W} y1={Y(0)} y2={Y(0)} />
  {compact ? (
    <>
      <text class="tick" x="0" y={H - 2}>0%</text>
      <text class="tick" x={W} y={H - 2} text-anchor="end">100% wins</text>
    </>
  ) : (
    [0, 0.25, 0.5, 0.75, 1].map((g) => (
      <text class="tick" x={X(g)} y={H - 8} text-anchor={g === 0 ? 'start' : g === 1 ? 'end' : 'middle'}>{pct(g)}</text>
    ))
  )}
</svg>

<style>
  .density { display: block; width: 100%; height: auto; overflow: visible; }
  .grid { stroke: var(--rule); stroke-width: 0.8; }
  .axis { stroke: var(--muted); stroke-width: 1; }
  .night { --c: var(--night); }
  .day { --c: var(--day); }
  .fill { fill: var(--c); opacity: 0.13; }
  .stroke { fill: none; stroke: var(--c); stroke-width: 2.4; stroke-linejoin: round; }
  .compact .stroke { stroke-width: 1.8; }
  .ucb { stroke: var(--c); stroke-width: 2; stroke-dasharray: 4 3; }
  .mean { fill: var(--c); stroke: var(--surface); stroke-width: 2; }
  .tick { font-family: var(--font-display); font-size: 12px; fill: var(--muted); }
  .compact .tick { font-size: 10px; }
</style>
