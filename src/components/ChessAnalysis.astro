---
import ChessDensity from '../components/ChessDensity.astro';
import ChessMonitor from '../components/ChessMonitor.astro';
import { current, decision, declared, fetchedAt, ARMS, QUANTILE, DRAWS, DECIDE_AT, pct, type ArmId } from '../chess';

const ids: ArmId[] = ['night', 'day'];
const updated = new Date(fetchedAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jerusalem' });

// Rendered both as the /chess page (level 1) and as a home-page section (level 2).
// Level 3 is the embedded view inside the Projects card: no title or intro.
interface Props { level?: 1 | 2 | 3 }
const { level = 1 } = Astro.props;
const Title = level === 1 ? 'h1' : 'h2';
const Sub = (['h2', 'h3', 'h5'] as const)[level - 1];
const embedded = level === 3;
---
<div class="chess-analysis">
    {!embedded && (
      <>
        <Title class="title">Mac at night or phone by day?</Title>
        <p class="lede muted prose">
          I play rapid chess on a wide screen at night and on my phone during the day. Each setup is an
          arm in a two-armed bandit, and the data picks my next game.
        </p>
      </>
    )}

    <section class="verdict">
      <div>
        <p class="k">Next game</p>
        <p class={`v ${decision.explore}`}>{ARMS[decision.explore].label}</p>
        <p class="muted">Highest {Math.round(QUANTILE * 100)}th percentile (UCB)</p>
      </div>
      <div>
        <p class="k">Better on the estimate</p>
        <p class={`v ${decision.exploit}`}>{ARMS[decision.exploit].label}</p>
        <p class="muted">Highest posterior mean</p>
      </div>
      <p class="agree">
        {decision.agree
          ? 'Both rules agree, so the next game exploits.'
          : `The rules disagree. The estimate favours ${ARMS[decision.exploit].label}, but I'll follow UCB and explore ${ARMS[decision.explore].label}.`}
      </p>
    </section>

    <section class="block">
      <Sub>Beta distributions of the two game types</Sub>
      <p class="muted">Each curve is the Beta posterior of that setup's win rate: where it probably sits, and how sure I am.</p>
      <ul class="legend">
        {ids.map((id) => (
          <li class={id}>
            <span class="swatch" aria-hidden="true"></span>
            <strong>{ARMS[id].label}</strong>
            <span class="muted">{ARMS[id].hours}</span>
          </li>
        ))}
        <li class="key muted">Dot: estimate. Dashed line: {Math.round(QUANTILE * 100)}th percentile.</li>
      </ul>
      <ChessDensity />
      <table>
        <thead><tr><th>Setup</th><th>Games</th><th>W–L–D</th><th>Estimate</th><th>{Math.round(QUANTILE * 100)}th pct</th></tr></thead>
        <tbody>
          {ids.map((id) => (
            <tr class={id}>
              <th scope="row"><span class="swatch" aria-hidden="true"></span>{ARMS[id].label}</th>
              <td class="num">{current[id].n}</td>
              <td class="num">{current[id].wins}–{current[id].losses}–{current[id].draws}</td>
              <td class="num">{pct(current[id].mean)}</td>
              <td class="num">{pct(current[id].ucb)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="block">
      <Sub>Which setup is better?</Sub>
      <p class="muted">
        Every day, {DRAWS.toLocaleString('en-US')} draws from both distributions: each line is the share of rounds that setup's win rate came out higher.
        I declare a winner when one reaches {Math.round(DECIDE_AT * 100)}%{declared && ', and keep playing both after (dashed)'}.
      </p>
      <ChessMonitor />
    </section>

    <section class="block method prose">
      <Sub>Method</Sub>
      <p>
        Games are split by the hour they ended: 21:00–06:00 on the Mac, the rest on the phone. Each win rate is a Beta posterior
        (uniform prior, draws count half), and the next game goes to the higher {Math.round(QUANTILE * 100)}th percentile (Bayes-UCB).
      </p>
      <p class="muted">Updated daily. Last update {updated}.</p>
    </section>
</div>

<style>
  .lede { font-size: 1.2rem; }
  .night { --c: var(--night); }
  .day { --c: var(--day); }

  .verdict { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 32px; margin: 36px 0 48px; padding: 24px; background: var(--surface); border: 1px solid var(--rule); border-radius: 16px; }
  .verdict p { margin: 0; }
  .k { font: 500 0.9rem var(--font-display); color: var(--muted); }
  .v { font: 400 clamp(1.6rem, 3.6vw, 2.3rem)/1.15 var(--font-heading); letter-spacing: -0.01em; color: var(--c); margin: 4px 0 !important; }
  .verdict .muted { font-size: 0.9rem; }
  .agree { grid-column: 1 / -1; padding-top: 16px; border-top: 1px solid var(--rule); }
  @media (max-width: 600px) { .verdict { grid-template-columns: 1fr; } }

  .block { padding: 36px 0; border-top: 1px solid var(--rule); }
  .block :is(h2, h3, h5) { font-size: var(--step-1); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0 0 18px; padding: 0; font-family: var(--font-display); font-size: 0.95rem; }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: var(--c); margin-right: 8px; }
  .legend .swatch { margin: 0; }

  table { width: 100%; border-collapse: collapse; margin-top: 24px; font-family: var(--font-display); font-size: 0.95rem; }
  th, td { text-align: right; padding: 8px 10px; border-bottom: 1px solid var(--rule); }
  th:first-child { text-align: left; font-weight: 600; }
  thead th { color: var(--muted); font-weight: 500; }
  @media (max-width: 520px) { th, td { padding: 8px 4px; font-size: 0.85rem; } }
</style>
