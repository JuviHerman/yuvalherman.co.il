---
// Estimate (solid) and 90th percentile (dashed) per arm after each day of play,
// with the day's recommendation underneath.
import { timeline, liveFrom, simulatedGames, ARMS, type ArmId } from '../chess';

const W = 640, top = 12, plotH = 200, stripY = plotH + top + 22, H = stripY + 40;
const n = timeline.length;
const X = (i: number) => (n === 1 ? W / 2 : 24 + (i * (W - 48)) / (n - 1));
const Y = (v: number) => top + plotH * (1 - v);
const ids: ArmId[] = ['night', 'day'];
const path = (id: ArmId, key: 'mean' | 'ucb') => timeline.map((d, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(d[id][key]).toFixed(1)}`).join(' ');
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
const labelEvery = Math.max(1, Math.ceil(n / 6));
const cell = Math.max(2, Math.min(28, (W - 48) / Math.max(n, 1) - 4));
const dots = n <= 30;
// Where the simulated warm-up ends and live chess.com games begin.
const liveIndex = simulatedGames && liveFrom ? timeline.findIndex((d) => d.date >= liveFrom) : -1;
const liveX = liveIndex > 0 ? (X(liveIndex - 1) + X(liveIndex)) / 2 : null;
---
<svg class="timeline" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Win-rate estimate and 90th percentile for each setup after every day of play, with the daily recommendation.">
  {[0, 0.25, 0.5, 0.75, 1].map((g) => (
    <g><line class="grid" x1="0" x2={W} y1={Y(g)} y2={Y(g)} /><text class="tick" x="0" y={Y(g) - 4}>{Math.round(g * 100)}%</text></g>
  ))}
  {liveX !== null && (
    <g>
      <rect class="sim" x="0" y={top} width={liveX} height={plotH} />
      <line class="live" x1={liveX} x2={liveX} y1={top} y2={stripY + 12} />
      <text class="tick" x={liveX - 6} y={top + 14} text-anchor="end">Simulated</text>
      <text class="tick" x={liveX + 6} y={top + 14}>Live</text>
    </g>
  )}
  {ids.map((id) => (
    <g class={id}>
      <path class="ucb" d={path(id, 'ucb')} />
      <path class="mean" d={path(id, 'mean')} />
      {dots && timeline.map((d, i) => d[id].n > 0 && <circle cx={X(i)} cy={Y(d[id].mean)} r="3.5" />)}
    </g>
  ))}
  <text class="tick" x="0" y={stripY - 6}>Recommended next</text>
  {timeline.map((d, i) => (
    <g>
      <rect class={`rec ${d.decision.explore}`} x={X(i) - cell / 2} y={stripY} width={cell} height="12" rx="3">
        <title>{fmt(d.date)}: {ARMS[d.decision.explore].label}</title>
      </rect>
      {(i % labelEvery === 0 || i === n - 1) && <text class="tick" x={X(i)} y={stripY + 30} text-anchor="middle">{fmt(d.date)}</text>}
    </g>
  ))}
</svg>

<style>
  .timeline { display: block; width: 100%; height: auto; overflow: visible; }
  .sim { fill: var(--muted); opacity: 0.07; }
  .live { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; }
  .grid { stroke: var(--rule); stroke-width: 0.8; }
  .tick { font-family: var(--font-display); font-size: 12px; fill: var(--muted); }
  .night { --c: var(--night); }
  .day { --c: var(--day); }
  .mean { fill: none; stroke: var(--c); stroke-width: 2.4; }
  .ucb { fill: none; stroke: var(--c); stroke-width: 1.6; stroke-dasharray: 5 4; opacity: 0.8; }
  circle { fill: var(--c); }
  .rec.night { fill: var(--night); }
  .rec.day { fill: var(--day); }
</style>
