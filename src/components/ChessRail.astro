---
// Chess panel shown on every page: a rail on wide screens, a collapsible dock otherwise.
import ChessSummary from './ChessSummary.astro';
import { decision, ARMS } from '../chess';
---
<aside class="chess-rail" aria-label="Chess, off the clock">
  <p class="title">Chess, off the clock</p>
  <ChessSummary />
</aside>

<details class="chess-dock">
  <summary>
    <span class="knight" aria-hidden="true">♞</span>
    <span>Next chess game: <strong class={decision.explore}>{ARMS[decision.explore].label}</strong></span>
  </summary>
  <div class="dock-body"><ChessSummary /></div>
</details>

<style>
  .title { font: 450 1.2rem var(--font-heading); color: var(--accent); margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }

  .chess-rail {
    display: none;
    position: fixed; top: 0; right: 0; bottom: 0; width: 300px; overflow-y: auto;
    padding: 28px 24px; background: var(--surface); border-left: 1px solid var(--rule); z-index: 5;
  }
  @media (min-width: 1400px) {
    .chess-rail { display: block; }
    .chess-dock { display: none; }
    :global(body) { padding-right: 300px; }
  }

  .chess-dock {
    position: fixed; right: 12px; bottom: 12px; z-index: 5;
    width: min(340px, calc(100vw - 24px));
    background: var(--surface); border: 1px solid var(--rule); border-radius: 14px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
  }
  @media (max-width: 1399px) { :global(body) { padding-bottom: 72px; } }
  summary {
    display: flex; align-items: center; gap: 10px; padding: 12px 16px; cursor: pointer;
    font: 500 0.95rem var(--font-display); list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary strong.night { color: var(--night); }
  summary strong.day { color: var(--day); }
  .knight { font-size: 1.3rem; line-height: 1; }
  .chess-dock[open] summary { border-bottom: 1px solid var(--rule); }
  .dock-body { padding: 16px; max-height: 70vh; overflow-y: auto; }

  @media print { .chess-rail, .chess-dock { display: none; } }
</style>
