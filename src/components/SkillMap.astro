---
// Tabbed skill map. Without JS every panel is visible; the script turns it into tabs.
import { skillAreas } from '../data';
import ChessAnalysis from './ChessAnalysis.astro';
import { decision, ARMS } from '../chess';

// '*Ranked* where…' → ['', 'Ranked', ' where…']: odd entries are the highlighted verbs.
const verbs = (text: string) => text.split(/\*(.+?)\*/);
---
<div class="skillmap">
  <div class="tabs" role="tablist" aria-label="Skill areas" hidden>
    {skillAreas.map((a, i) => (
      <button type="button" role="tab" id={`tab-${a.id}`} aria-controls={`skill-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        {a.name}
      </button>
    ))}
  </div>

  {skillAreas.map((a) => (
    <section class="panel" id={`skill-${a.id}`} role="tabpanel" aria-labelledby={`tab-${a.id}`}>
      <header class="panel-head">
        <h3>{a.name}</h3>
        <p class="muted">{a.tagline}</p>
      </header>
      {a.cases.length > 0 && (
        <ul class="cards">
          {a.cases.map((c) => {
            const body = (
              <>
                <p class="skill caps">{c.skill}</p>
                <h4 class="code">{c.code}</h4>
                <p class="what">{verbs(c.what).map((part, i) => (i % 2 ? <strong class="verb">{part}</strong> : part))}</p>
                {c.expand === 'chess' && <p class="result">Next game: {ARMS[decision.explore].label}</p>}
                {c.result && <p class="result num">{c.result}</p>}
                {c.stack && <ul class="tags">{c.stack.map((t) => <li>{t}</li>)}</ul>}
              </>
            );
            return c.expand ? (
              <li class="card expandable">
                <details class="experiment" id={c.expand}>
                  <summary>
                    {body}
                    <span class="more caps"><span class="show">See the experiment</span><span class="hide">Hide the experiment</span></span>
                  </summary>
                  <div class="experiment-body"><ChessAnalysis level={3} /></div>
                </details>
              </li>
            ) : (
              <li class="card">
                {body}
                {c.href && <a class="more caps" href={c.href}>{c.linkLabel ?? 'Details'} →</a>}
              </li>
            );
          })}
        </ul>
      )}
      {a.also?.map((g) => (
        <div class="also">
          <p class="caps">{g.name}</p>
          <ul class="items">{g.items.map((t) => <li>{t}</li>)}</ul>
        </div>
      ))}
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('.skillmap');
  if (root) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    list.hidden = false;
    root.classList.add('enhanced');

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
      if (focus) tabs[i].focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const next = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
        if (next !== undefined) { e.preventDefault(); select(next, true); }
      });
    });

    // Links elsewhere on the page (hero index, top bar) open a tab, or an experiment, by hash.
    const fromHash = () => {
      const i = panels.findIndex((p) => `#${p.id}` === location.hash);
      if (i >= 0) { select(i); root.scrollIntoView({ block: 'start' }); return; }
      const exp = location.hash ? root.querySelector<HTMLDetailsElement>(`details${location.hash}`) : null;
      if (exp) {
        select(panels.findIndex((p) => p.contains(exp)));
        exp.open = true;
        exp.scrollIntoView({ block: 'start' });
      }
    };
    root.closest('body')?.querySelectorAll<HTMLAnchorElement>('a[href="/#chess"]').forEach((a) =>
      a.addEventListener('click', () => setTimeout(fromHash, 0)),
    );
    window.addEventListener('hashchange', fromHash);
    select(Math.max(0, panels.findIndex((p) => `#${p.id}` === location.hash)));
    fromHash();
  }
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  [role='tab'] {
    font: 450 0.8rem var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: transparent;
    border: 1.5px solid var(--rule); border-radius: 999px; padding: 8px 18px; cursor: pointer;
  }
  [role='tab']:hover { color: var(--accent); border-color: var(--accent); }
  [role='tab'][aria-selected='true'] { background: var(--accent); color: var(--surface); border-color: var(--accent); }

  .panel + .panel { margin-top: 56px; }
  .enhanced .panel + .panel { margin-top: 0; }
  .panel-head { margin-bottom: 24px; }
  .panel-head h3 { font-size: var(--step-3); margin-bottom: 0.15em; }
  .enhanced .panel-head h3 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .panel-head p { font-size: 1.2rem; margin: 0; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .card {
    display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 20px;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 14px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--rule)); box-shadow: 0 8px 24px rgb(0 0 0 / 0.07); transform: translateY(-2px); }
  .card p { margin: 0; }
  .skill { color: var(--muted); font-size: 0.72rem; }
  .code { font: 450 1.45rem/1.2 var(--font-heading); color: var(--accent); margin: 0; }
  .what { color: var(--muted); font-size: 0.98rem; line-height: 1.55; }
  .verb { color: var(--ink); font-weight: 600; }
  .result { font: 650 0.95rem var(--font-ui); color: var(--green); }
  .card .tags { margin: 4px 0 0; }
  .more { margin-top: auto; padding-top: 10px; color: var(--accent); text-decoration: none; align-self: flex-start; }
  a.more:hover { text-decoration: underline; text-underline-offset: 0.3em; }

  .expandable { padding: 0; }
  .expandable:has(details[open]) { grid-column: 1 / -1; transform: none; }
  .experiment summary { display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 20px; cursor: pointer; list-style: none; height: 100%; }
  .experiment { height: 100%; }
  .experiment summary::-webkit-details-marker { display: none; }
  .experiment .more::after { content: ' +'; }
  .experiment[open] .more::after { content: ' −'; }
  .more .hide, .experiment[open] .more .show { display: none; }
  .experiment[open] .more .hide { display: inline; }
  .experiment[open] summary { border-bottom: 1px solid var(--rule); }
  .experiment-body { padding: 8px 22px 22px; --halo: var(--surface); }

  .also { display: grid; grid-template-columns: minmax(0, 200px) minmax(0, 1fr); gap: 10px 40px; padding: 18px 0; border-top: 1px solid var(--rule); margin-top: 28px; }
  .also + .also { margin-top: 0; }
  .also > p { color: var(--muted); margin: 0.4em 0 0; }
  @media (max-width: 720px) { .also { grid-template-columns: minmax(0, 1fr); } }
  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .items li { font: 400 0.95rem var(--font-ui); border: 1px solid var(--rule); border-radius: 8px; padding: 5px 12px; background: var(--surface); }
  .panel:not(:has(.cards)) .also:first-of-type { margin-top: 0; }
</style>
